{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": {
    "enabled": true
  },
  "sortTailwindcss": {
    "enabled": true,
    "stylesheet": "./apps/web/src/app/styles/app.css"
  },
  "sortPackageJson": {
    "enabled": true
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.react-router/**",
    "**/coverage/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "**/storybook-static/**",
    "**/pnpm-lock.yaml",
    "apps/api/drizzle/**"
  ]
}
