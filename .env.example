# Shared / local
DATABASE_URL=postgresql://closet:closet@localhost:5432/closet

# API (apps/api)
API_PORT=8080
API_HOST=0.0.0.0
# Use the same host you open in the browser (localhost OR 127.0.0.1).
# API CORS also allows the localhost↔127.0.0.1 twin automatically.
WEB_ORIGIN=http://localhost:5173
CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
LOCAL_STORAGE_DIR=.data/storage
WEATHER_PROVIDER=open-meteo

# Optional AI (falls back to mock vision/LLM when missing)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional S3/MinIO (defaults to local filesystem storage)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Web (apps/web) — Vite exposes only VITE_* vars
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Empty = same-origin `/v1` via Vite proxy (recommended locally). Absolute URL if API is remote.
VITE_API_BASE_URL=
